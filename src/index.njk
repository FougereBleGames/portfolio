---
layout: layout.njk
permalink: /
---
{% from "macros.njk" import itchIcon, youtubeIcon %}
<div class="container-fluid">
  <div class="row">
    <section id="navigation-bar" class="navigation position-fixed">
      <ul class="nav nav-pills text-center align-items-center mt-5 ms-xl-5 ms-3">
        <li>
          <a href="#jeux" class="nav-link active rounded-0" aria-current="page" data-bs-toggle="tooltip" data-bs-placement="right" title="Les jeux">
            <iconify-icon icon="ic:round-sports-esports"></iconify-icon>
          </a>
        </li>
        <li>
          <a href="#a-propos" class="nav-link rounded-0" data-bs-toggle="tooltip" data-bs-placement="right" title="À propos">
            <iconify-icon icon="ic:round-person"></iconify-icon>
          </a>
        </li>
        <li>
          <a href="{{ site.itch_url }}" class="nav-link rounded-0" target="_blank" rel="noopener noreferrer" data-bs-toggle="tooltip" data-bs-placement="right" title="Itch.io">
            {{ itchIcon() }}
          </a>
        </li>
        <li>
          <a href="{{ site.youtube_url }}" class="nav-link rounded-0" target="_blank" rel="noopener noreferrer" data-bs-toggle="tooltip" data-bs-placement="right" title="YouTube">
            {{ youtubeIcon() }}
          </a>
        </li>
      </ul>
    </section>

    <div class="col-xl-6 offset-xl-2">
      <div class="container content-container">
        <section id="jeux">
          <div class="py-4 my-4">
            <p class="eyebrow">{{ site.games.eyebrow }}</p>
            <h1 class="fw-bold">{{ site.games.title }}</h1>
          </div>
          <ul class="game-grid">
            {% for game in collections.games %}
            <li class="game-card">
              <img src="{{ game.data.image }}" alt="" />
              <div class="game-card-body">
                <h3>{{ game.data.title }}</h3>
                <a href="{{ game.data.url }}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">
                  {% if game.data.url | isItch %}{{ itchIcon() }}{% endif %}{{ game.data.cta or "Jouer" }}
                </a>
              </div>
            </li>
            {% endfor %}
          </ul>
        </section>

        <section id="a-propos">
          <hr class="mid-break my-2" />
          <div class="py-4 my-4">
            <p class="eyebrow">{{ about.eyebrow }}</p>
            <h1 class="fw-bold">{{ about.title }}</h1>
            <div class="about-copy">{{ about.lead | md | safe }}</div>
            <a href="{{ about.cta_href }}" class="btn btn-primary btn-lg mt-4" target="_blank" rel="noopener noreferrer">
              {% if about.cta_href | isItch %}{{ itchIcon() }}{% endif %}{{ about.cta_label }}
            </a>
          </div>
        </section>
      </div>
    </div>

    <div class="hero-sidebar col-12 col-xl-3 offset-xl-1 order-first order-xl-last">
      <header class="hero">
        <div class="container hero-container text-center my-4 pt-3 align-content-between">
          {% include "sidebar.njk" %}
        </div>
      </header>
    </div>
  </div>
</div>
